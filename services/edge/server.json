{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.carson-see/arkova-verification",
  "title": "Arkova Verification",
  "description": "Privacy-first document verification anchored to the public ledger.",
  "version": "1.0.1",
  "websiteUrl": "https://app.arkova.ai/developers",
  "repository": {
    "url": "https://github.com/carson-see/ArkovaCarson",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://edge.arkova.ai/mcp",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "Arkova API key. Get one at https://app.arkova.ai/settings/api-keys",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "toolCount": 16,
      "toolListDoc": "https://arkova.ai/.well-known/mcp/server-card.json"
    }
  }
}
