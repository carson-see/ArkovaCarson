{
  "name": "@arkova/worker",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 src/ \"scripts/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke:docusign": "tsx scripts/ops/docusign-connect-smoke.ts",
    "smoke:ops-slo": "tsx scripts/ops/ops-slo-smoke.ts",
    "eval:regression": "tsx scripts/nessie-eval-regression.ts",
    "eval:s3-gate": "tsx src/ai/eval/run-pe-gates.ts --dataset s3 --provider fixture --recorded src/ai/eval/recorded/s3-cpe-cle-recorded.json",
    "eval:s3-gate:seed": "tsx src/ai/eval/run-pe-gates.ts --dataset s3 --provider mock --seed-recorded src/ai/eval/recorded/s3-cpe-cle-recorded.json",
    "audit:golden": "tsx scripts/golden-distribution-audit.ts",
    "build:circuit": "bash circuits/build.sh"
  },
  "dependencies": {
    "@arizeai/openinference-semantic-conventions": "2.5.0",
