                {
                    "id": "sentry.rules.filters.level.LevelFilter",
                    "match": "gte",
                    "level": "30"
                }
            ],
            "actions": [
                {
                    "id": "sentry.integrations.slack.notify_action.SlackNotifyServiceAction",
                    "channel": "#ops",
                    "tags": "story"
                }
            ],
            "frequency": 1440
        },
        {
            "name": "SCRUM-1247 — Cloud Run revision drift",
            "environment": "production",
            "actionMatch": "all",
            "filterMatch": "all",
            "conditions": [
