{
  "name": "arkova",
  "version": "2.2.0",
  "description": "Arkova verification SDK — anchor and verify documents with cryptographic proof",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "examples", "!examples/agents.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": ["arkova", "verification", "anchor", "credentials", "x402"],
  "author": "Arkova <engineering@arkova.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carson-see/ArkovaCarson",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  }
}
