{
  "name": "arkova-api-cli",
  "version": "0.3.0",
  "description": "JSON command-line client for the Arkova verification API",
  "private": true,
  "type": "module",
  "bin": {
    "arkova": "dist/cli.js"
  },
  "scripts": {
    "prebuild": "npm --prefix ../sdk run build && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretypecheck": "npm --prefix ../sdk run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "prepublishOnly": "npm run typecheck && npm test && npm run lint"
  },
  "dependencies": {
    "arkova": "file:../sdk"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@types/node": "26.0.0",
    "eslint": "10.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=20.14.0"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": ["arkova", "verification", "credentials", "cli"],
  "author": "Arkova <engineering@arkova.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carson-see/ArkovaCarson",
    "directory": "packages/api-cli"
  },
  "publishConfig": { "access": "public" }
}
