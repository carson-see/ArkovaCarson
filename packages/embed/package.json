{
  "name": "@arkova/embed",
  "version": "2.2.0",
  "description": "Arkova embeddable verification widget — single script tag, vanilla JS, no dependencies",
  "type": "module",
  "main": "dist/embed.umd.js",
  "module": "dist/embed.es.js",
  "files": ["dist", "LICENSE"],
  "scripts": {
    "build": "vite build",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
