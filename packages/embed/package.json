  "keywords": ["arkova", "verification", "embed", "widget", "credential"],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.6"
  }
}
