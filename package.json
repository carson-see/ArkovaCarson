{
  "name": "arkova",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.14.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "tsx scripts/fetch-ner-model.ts && tsx scripts/vendor-ner-runtime.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "fetch:ner-model": "tsx scripts/fetch-ner-model.ts",
    "vendor:ner-runtime": "tsx scripts/vendor-ner-runtime.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:copy": "tsx scripts/check-copy-terms.ts",
    "lint:batch-drain-evidence": "eslint --no-ignore scripts/staging/batch-drain-harness-lib.ts scripts/staging/batch-drain-harness-lib.test.ts scripts/staging/batch-drain-observation.ts scripts/staging/batch-drain-observation.test.ts scripts/staging/batch-drain-crash-control.ts scripts/staging/batch-drain-crash-control.test.ts scripts/staging/batch-drain-crash-adapter.ts scripts/staging/batch-drain-crash-adapter.test.ts scripts/staging/batch-drain-journal-crash.ts scripts/staging/batch-drain-journal-crash.test.ts scripts/staging/batch-drain-fault-control.ts scripts/staging/batch-drain-fault-control.test.ts scripts/staging/batch-drain-fault-adapter.ts scripts/staging/batch-drain-fault-adapter.test.ts scripts/staging/batch-drain-strict-json.ts scripts/staging/batch-drain-strict-json.test.ts scripts/staging/batch-drain-time.ts scripts/staging/batch-drain-time.test.ts scripts/staging/batch-drain-live-evidence.ts scripts/staging/batch-drain-live-evidence.test.ts scripts/staging/batch-drain-evidence-sources.test.ts scripts/staging/batch-drain-admission-adapter.ts scripts/staging/batch-drain-admission-adapter.test.ts scripts/staging/batch-drain-utxo-fanout.ts scripts/staging/batch-drain-utxo-fanout.test.ts scripts/staging/batch-drain-chain-readiness.ts scripts/staging/batch-drain-chain-readiness.test.ts scripts/staging/batch-drain-wave3-driver.ts scripts/staging/batch-drain-wave3-driver.test.ts scripts/staging/s33-b1-treasury-continuity.ts scripts/staging/s33-b1-treasury-continuity.test.ts",
    "gen:types": "supabase gen types typescript --local > src/types/database.types.ts",
    "ci:api-contract-drift": "tsx scripts/ci/check-api-contract-drift.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.config.rls.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:load": "vitest run tests/load",
    "analyze": "ANALYZE=true vite build && echo 'Bundle report: dist/bundle-stats.html'",
    "healthcheck": "tsx scripts/healthcheck/index.ts",
    "audit:secrets": "tsx scripts/secrets/audit-env.ts",
    "ci:api-scope-vocabulary": "tsx scripts/ci/check-api-scope-vocabulary.ts",
    "ci:anchor-index-justification": "tsx scripts/ci/check-anchor-index-justification.ts",
    "ci:dep-pinning": "tsx scripts/ci/check-dep-pinning.ts",
    "ci:install-script-policy": "tsx scripts/ci/check-npm-install-policy.ts",
    "ci:staging-gcloud-policy": "tsx scripts/ci/check-staging-gcloud-policy.ts",
    "ci:duplicate-artifacts": "tsx scripts/ci/check-duplicate-artifacts.ts",
    "ci:retry-after-429": "tsx scripts/ci/check-retry-after-429.ts",
    "ci:sonar-quality-gate": "tsx scripts/ci/check-sonar-quality-gate.ts",
    "security:license-denylist": "tsx scripts/security/license-denylist.ts package-lock.json services/worker/package-lock.json",
    "ci:staging-evidence": "tsx scripts/ci/check-staging-evidence.ts",
    "staging:seed": "tsx scripts/staging/seed.ts",
    "staging:load": "tsx scripts/staging/load-harness.ts",
    "staging:ai-soak": "tsx scripts/staging/ai-soak-harness.ts",
    "staging:soak-lanes": "tsx scripts/staging/soak-lanes.ts",
    "staging:claim": "./scripts/staging/claim.sh",
    "staging:janitor": "./scripts/staging/cleanup-orphan-tags.sh",
    "staging:rotate-iam": "./scripts/staging/rotate-deploy-iam.sh",
    "staging:teardown": "./scripts/staging/teardown-and-reset.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@radix-ui/react-alert-dialog": "1.1.18",
    "@radix-ui/react-avatar": "1.2.1",
    "@radix-ui/react-checkbox": "1.3.6",
    "@radix-ui/react-dialog": "1.1.18",
    "@radix-ui/react-dropdown-menu": "2.1.19",
    "@radix-ui/react-label": "2.1.11",
