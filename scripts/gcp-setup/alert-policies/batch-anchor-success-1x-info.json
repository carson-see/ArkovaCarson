{
  "displayName": "Arkova SLO burn 1x info: batch-anchor-success",
  "documentation": {
    "content": "SCRUM-1064: batch anchor success SLO budget is burning above 1x over 60m. Inspect batch-anchor cron results, chain provider health, and treasury readiness.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "story": "scrum_1064",
    "slo_id": "batch_anchor_success",
    "burn": "1x_info"
  },
  "conditions": [
    {
      "displayName": "batch-anchor-success burn > 1x",
      "conditionThreshold": {
        "filter": "select_slo_burn_rate(\"projects/${PROJECT_ID}/services/${SERVICE_ID}/serviceLevelObjectives/batch-anchor-success\", \"60m\")",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 1,
        "duration": "300s",
        "trigger": {
          "count": 1
        },
        "evaluationMissingData": "EVALUATION_MISSING_DATA_INACTIVE"
      }
    }
  ],
  "combiner": "OR",
  "enabled": true,
  "notificationChannels": ["${SLACK_OPS_ALERTS_CHANNEL}"],
  "alertStrategy": {
    "autoClose": "3600s"
  },
  "severity": "WARNING"
}
