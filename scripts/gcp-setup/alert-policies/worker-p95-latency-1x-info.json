{
  "displayName": "Arkova SLO burn 1x info: worker-p95-latency",
  "documentation": {
    "content": "SCRUM-1064: worker p95 latency SLO budget is burning above 1x over 60m. Inspect Cloud Run latency, database timeouts, and queue pressure.",
    "mimeType": "text/markdown"
  },
  "userLabels": {
    "story": "scrum_1064",
    "slo_id": "worker_p95_latency",
    "burn": "1x_info"
  },
  "conditions": [
    {
      "displayName": "worker-p95-latency burn > 1x",
      "conditionThreshold": {
        "filter": "select_slo_burn_rate(\"projects/${PROJECT_ID}/services/${SERVICE_ID}/serviceLevelObjectives/worker-p95-latency\", \"60m\")",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 1,
        "duration": "300s",
        "trigger": {
          "count": 1
        },
        "evaluationMissingData": "EVALUATION_MISSING_DATA_INACTIVE"
      }
    }
  ],
  "combiner": "OR",
  "enabled": true,
  "notificationChannels": ["${SLACK_OPS_ALERTS_CHANNEL}"],
  "alertStrategy": {
    "autoClose": "3600s"
  },
  "severity": "WARNING"
}
