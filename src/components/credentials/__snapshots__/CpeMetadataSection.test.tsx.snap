exports[`CpeMetadataSection — public verification view > snapshot: extraction_confidence is absent from the public rendered output 1`] = `"<section aria-label="CPE Details" class="rounded-xl border border-[#3c494e]/20 bg-[#192028] p-4 sm:p-5 space-y-4"><div class="flex flex-wrap items-center justify-between gap-3"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap h-4 w-4 text-[#00d4ff]" aria-hidden="true"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path><path d="M22 10v6"></path><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path></svg><h3 class="text-sm font-semibold uppercase tracking-widest text-[#dce3ed]">CPE Details</h3></div><span class="inline-flex items-center gap-1.5"><span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-hidden focus:ring-2 focus:ring-ring focus:ring-offset-2 shadow hover:bg-primary/80 bg-emerald-500/15 text-emerald-400 border border-emerald-500/30" data-nasba-status="confirmed">NASBA Registered</span><button type="button" aria-label="About NASBA registry status" aria-describedby="_rid_" class="inline-flex h-4 w-4 items-center justify-center rounded-full text-[#859398] hover:text-[#00d4ff] focus:outline-hidden focus-visible:ring-2 focus-visible:ring-[#00d4ff]/40" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button><span id="_rid_" class="sr-only">Arkova displays NASBA registry status for your reference. State boards of accountancy have final authority on CPE credit acceptance.</span></span></div><p class="text-base font-bold leading-tight text-[#dce3ed] break-words">Advanced Cloud Security for CPAs</p><dl class="grid gap-3 sm:grid-cols-2"><div class="rounded-lg bg-[#242b32] px-4 py-3"><dt class="mb-1 text-[10px] font-semibold uppercase tracking-widest text-[#859398]">Provider</dt><dd class="text-sm text-[#dce3ed]">Udemy</dd></div><div class="rounded-lg bg-[#242b32] px-4 py-3"><dt class="mb-1 text-[10px] font-semibold uppercase tracking-widest text-[#859398]">CPE Credits</dt><dd class="text-sm text-[#dce3ed]">7.0 CPE credits</dd></div><div class="rounded-lg bg-[#242b32] px-4 py-3"><dt class="mb-1 text-[10px] font-semibold uppercase tracking-widest text-[#859398]">Field of Study</dt><dd class="text-sm text-[#dce3ed]">Information Technology</dd></div><div class="rounded-lg bg-[#242b32] px-4 py-3"><dt class="mb-1 text-[10px] font-semibold uppercase tracking-widest text-[#859398]">Delivery Method</dt><dd class="text-sm text-[#dce3ed]">QAS Self-Study</dd></div><div class="rounded-lg bg-[#242b32] px-4 py-3"><dt class="mb-1 text-[10px] font-semibold uppercase tracking-widest text-[#859398]">Completion Date</dt><dd class="text-sm text-[#dce3ed]">May 18, 2026</dd></div><div class="rounded-lg bg-[#242b32] px-4 py-3"><dt class="mb-1 text-[10px] font-semibold uppercase tracking-widest text-[#859398]">Evidence Level</dt><dd class="text-sm text-[#dce3ed]">AI-Captured Evidence</dd></div></dl></section>"`;
